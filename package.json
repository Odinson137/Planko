{
  "name": "planko",
  "productName": "Planko",
  "author": "Planko Team",
  "private": true,
  "version": "1.0.0",
  "description": "Planko - Проектирование и раскрой стеновых панелей",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:desktop": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:preview": "npm run build && cross-env NODE_ENV=production electron .",
    "package": "npm run build && electron-packager . Planko --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/src$\" --ignore=\"^/tsconfig\"",
    "build:exe": "npm run build && electron-packager . Planko --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/src$\" --ignore=\"^/tsconfig\""
  },
  "build": {
    "appId": "com.allwall.planko",
    "productName": "Planko",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Planko"
    }
  },
  "dependencies": {
    "@mantine/core": "^7.12.2",
    "@mantine/hooks": "^7.12.2",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "konva": "^9.3.16",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.45",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^9.1.0"
  }
}
